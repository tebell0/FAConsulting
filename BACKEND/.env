# ── Server ────────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed CORS origins
# Local:      http://localhost:5173
# Production: http://<EC2_PUBLIC_IP>
FRONTEND_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────
DB_CLIENT=mysql
DB_HOST=<RDS_ENDPOINT>
DB_PORT=3306
DB_NAME=faconsulting
DB_USER=admin
DB_PASSWORD=<RDS_MASTER_PASSWORD>
DB_SSL=true

# ── Admin ─────────────────────────────────────────────────
# Secret token returned on sign-in and checked on all /api/admin/* routes
# Generate a strong random string: openssl rand -hex 32
ADMIN_SECRET=<generate_a_strong_random_secret>
# Fallback credentials used if admin_users table has no rows
ADMIN_USER=admin
ADMIN_PASSWORD=<fallback_admin_password>

# ── AWS Cognito (optional — provisioned for future SSO) ───
AUTH_MODE=local
COGNITO_USER_POOL_ID=us-east-1_0aWW5RCrL
COGNITO_CLIENT_ID=316cq6gpvrle2s8punb2s16p5k
COGNITO_REGION=us-east-1

# ── AWS S3 ────────────────────────────────────────────────
S3_BUCKET_NAME=photographers-suite-storage
S3_REGION=us-east-1
# Leave blank when deployed on EC2 — IAM LabRole provides credentials automatically.
# Only set these for local development if you need to test S3 uploads.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
